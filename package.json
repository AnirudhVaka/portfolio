{
  "name": "anirudhvaka-dev",
  "version": "2.0.0",
  "private": true,
  "description": "Geo-adaptive portfolio + region-aware resume for Anirudh Vaka. Next.js 15 + Vercel.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:docx && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:docx": "tsx scripts/build-docx.ts",
    "build:docx:py": "node --experimental-strip-types --no-warnings scripts/dump-data.mjs > /tmp/resume-data.json && python3 scripts/build_docx.py /tmp/resume-data.json public/downloads/"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "docx": "9.0.3",
    "eslint": "9.14.0",
    "eslint-config-next": "15.0.3",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
